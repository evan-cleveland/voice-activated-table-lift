[Unit]
Description=Voice-Activated Table Lift Bridge
After=network.target sound.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/voice-activated-table-lift/code/pi
ExecStart=/usr/bin/python3 /home/pi/voice-activated-table-lift/code/pi/voice_bridge.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
